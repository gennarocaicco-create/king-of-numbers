const RARITY = {
  common: { label: "Commun", bonus: 1, color: "#9aa4b2", rating: 1100 },
  rare:   { label: "Rare", bonus: 3, color: "#5ad1ff", rating: 1300 },
  epic:   { label: "Épique", bonus: 5, color: "#c77dff", rating: 1600 },
  legend: { label: "Légendaire", bonus: 10, color: "#ffd166", rating: 1900 },
};
const TITLES = [
  { min: 0, t: "Recrue" }, { min: 1000, t: "Supporter" }, { min: 1200, t: "Connaisseur" },
  { min: 1400, t: "Expert" }, { min: 1600, t: "Maître des numéros" }, { min: 1800, t: "👑 Roi des numéros" },
];
const titleFor = (elo) => TITLES.reduce((a, x) => (elo >= x.min ? x.t : a), "Recrue");

/* ---------- persistance locale (localStorage + repli mémoire) ---------- */
const mem = {};
const store = {
  ok: (() => { try { localStorage.setItem("__t", "1"); localStorage.removeItem("__t"); return true; } catch { return false; } })(),
  get(k, def) { try { if (this.ok) { const v = localStorage.getItem(k); return v ? JSON.parse(v) : def; } } catch {} return k in mem ? mem[k] : def; },
  set(k, v) { mem[k] = v; try { if (this.ok) localStorage.setItem(k, JSON.stringify(v)); } catch {} },
};

/* ---------- classement : Firebase (window.KingDB) ou repli local ---------- */
const localSubs = [];
const localList = () => Object.values(store.get("kings", {})).sort((a, b) => b.elo - a.elo);
const localDB = {
  ready: false,
  async saveProfile(p) { const all = store.get("kings", {}); all[p.id] = p; store.set("kings", all); localSubs.forEach((cb) => cb(localList())); },
  subscribeLeaderboard(cb) { localSubs.push(cb); cb(localList()); return () => { const i = localSubs.indexOf(cb); if (i >= 0) localSubs.splice(i, 1); }; },
};
const getDB = () => (window.KingDB ? window.KingDB : localDB);

/* ---------- utils ---------- */
const norm = (s) => s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9 ]/g, "").trim();
const nameMatches = (input, player) => {
  const i = norm(input); if (!i) return false;
  const full = norm(player); const parts = full.split(" "); const last = parts[parts.length - 1];
  if (i === full || i === last) return true;
  if (i.length >= 4 && parts.includes(i)) return true;
  return false;
};
const timeScore = (sec) => (sec <= 5 ? 10 : sec <= 15 ? 7 : 5);
const shuffle = (a) => [...a].sort(() => Math.random() - 0.5);
const uid = () => "u_" + Math.random().toString(36).slice(2, 10);

const C = { bg: "#0a0e14", panel: "#121822", line: "#1f2937", lime: "#c6ff00", ink: "#e7ecf3", mute: "#7b8794", red: "#ff5d5d", green: "#3ee08a" };

function Confetti() {
  const bits = useMemo(() => Array.from({ length: 60 }, () => ({
    l: Math.random() * 100, d: Math.random() * 0.6, dur: 1.4 + Math.random() * 1.2,
    c: [C.lime, "#5ad1ff", "#ffd166", "#ff7eb6", "#fff"][Math.floor(Math.random() * 5)], s: 6 + Math.random() * 8,
  })), []);
  return (
    <div style={{ position: "fixed", inset: 0, pointerEvents: "none", overflow: "hidden", zIndex: 50 }}>
      {bits.map((b, i) => (
        <div key={i} style={{ position: "absolute", top: -20, left: b.l + "%", width: b.s, height: b.s * 0.5,
          background: b.c, borderRadius: 2, animation: `fall ${b.dur}s ${b.d}s ease-in forwards` }} />
      ))}
    </div>
  );
}

function App() {
  const [profile, setProfile] = useState(() => {
    let p = store.get("profile", null);
    if (!p) { p = { id: uid(), pseudo: "", elo: 1200, games: 0, best: 0 }; store.set("profile", p); }
    return p;
  });
  const [screen, setScreen] = useState(profile.pseudo ? "home" : "onboard");
  const save = (patch) => setProfile((p) => {
    const np = { ...p, ...patch }; store.set("profile", np);
    if (np.pseudo) getDB().saveProfile(np); return np;
  });
  const go = (s) => setScreen(s);
  return (
    <div style={{ minHeight: "100dvh", background: C.bg, color: C.ink, fontFamily: "Sora, sans-serif",
