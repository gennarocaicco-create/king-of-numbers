<!-- 1) Firebase REALTIME DATABASE (classement partagé). Tant que la config = "TODO", le jeu reste LOCAL. -->
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
  import { getDatabase, ref, set, query, orderByChild, limitToLast, onValue }
    from "https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";

  // ----- TA CONFIG ICI -----
  // apiKey, authDomain, projectId, appId : Console > ⚙️ Paramètres du projet > section "Tes applications".
  // databaseURL : c'est l'adresse de TA Realtime Database (ex. https://king-of-bumbers-default-rtdb.europe-west1.firebasedatabase.app).
  const firebaseConfig = {
    apiKey: "TODO",
    authDomain: "TODO.firebaseapp.com",
    databaseURL: "TODO",
    projectId: "TODO",
    appId: "TODO",
  };

  if (firebaseConfig.databaseURL !== "TODO") {
    const db = getDatabase(initializeApp(firebaseConfig));
    window.KingDB = {
      ready: true,
      async saveProfile({ id, pseudo, elo, games, best }) {
        await set(ref(db, "kings/" + id),
          { pseudo, elo, games, best, updatedAt: Date.now() });
      },
      subscribeLeaderboard(cb) {
        const q = query(ref(db, "kings"), orderByChild("elo"), limitToLast(50));
        return onValue(q, (snap) => {
          const arr = [];
          snap.forEach((c) => arr.push({ id: c.key, ...c.val() }));
          arr.reverse(); // du plus haut ELO au plus bas
          cb(arr);
        });
      },
    };
    window.dispatchEvent(new Event("kingdb-ready"));
  }
  // Règles Realtime Database (onglet "Règles") :
  // { "rules": { "kings": { ".read": true, ".write": true, ".indexOn": "elo" } } }
</script>

