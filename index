function Game({ mode, go, profile, save }) {
  const deck = useRef(shuffle(DB));
  const [idx, setIdx] = useState(0);
  const [val, setVal] = useState("");
  const [phase, setPhase] = useState("ask");
  const [last, setLast] = useState(null);
  const [score, setScore] = useState(0);
  const [streak, setStreak] = useState(0);
  const [elo, setElo] = useState(profile.elo);
  const [confetti, setConfetti] = useState(false);
  const startRef = useRef(Date.now());
  const inputRef = useRef(null);
  const q = deck.current[idx % deck.current.length];
  const r = RARITY[q.rarity];
  useEffect(() => { startRef.current = Date.now(); setTimeout(() => inputRef.current && inputRef.current.focus(), 50); }, [idx]);
  const submit = () => {
    if (phase !== "ask" || val === "") return;
    const sec = (Date.now() - startRef.current) / 1000;
    let correct = false, pts = 0, exact = false;
    if (mode === "quiz") { correct = nameMatches(val, q.player); if (correct) pts = timeScore(sec) + r.bonus; }
    else { const g = parseInt(val, 10);
      if (g === q.number) { correct = true; exact = true; pts = 10 + r.bonus; }
      else if (Math.abs(g - q.number) === 1) { correct = true; pts = 3; } }
    if (exact) { setConfetti(true); setTimeout(() => setConfetti(false), 2200); }
    setScore((s) => s + pts); setStreak((k) => (correct ? k + 1 : 0));
    setElo((e) => { const exp = 1 / (1 + 10 ** ((r.rating - e) / 400)); return Math.round(e + 24 * ((correct ? 1 : 0) - exp)); });
    setLast({ correct, pts, sec: sec.toFixed(1), exact }); setPhase("result");
  };
  const next = () => {
    if (idx >= 9) { save({ elo, games: profile.games + 1, best: Math.max(profile.best, score) }); go("board"); return; }
    setVal(""); setLast(null); setPhase("ask"); setIdx((i) => i + 1);
  };
  return (
    <div>
      {confetti && <Confetti />}
      <TopBar go={go} title={mode === "quiz" ? "Qui portait ce numéro ?" : "Mode Inversé"} right={`Q ${idx + 1}/10`} />
      <div style={{ display: "flex", justifyContent: "space-between", margin: "14px 2px 18px", fontSize: 13 }}>
        <span style={{ color: C.mute }}>Score <strong style={{ color: C.ink }}>{score}</strong></span>
        <span style={{ color: streak > 1 ? C.lime : C.mute }}>{streak > 1 ? `⚡ ${streak} d'affilée` : "Série 0"}</span>
        <span style={{ color: C.mute }}>ELO <strong style={{ color: C.lime }}>{elo}</strong></span>
      </div>
      <div style={{ background: C.panel, border: `1px solid ${C.line}`, borderRadius: 22, padding: 22, position: "relative", overflow: "hidden", animation: "pop .25s ease both" }}>
        <span style={{ position: "absolute", top: 14, right: 16, fontSize: 11, fontWeight: 700, color: r.color, border: `1px solid ${r.color}55`, borderRadius: 999, padding: "3px 10px" }}>{r.label} +{r.bonus}</span>
        {mode === "quiz" ? (
          <>
            <div style={{ color: C.mute, fontSize: 13, marginTop: 6 }}>{q.club}</div>
            <div style={{ color: C.mute, fontSize: 13 }}>Saison {q.season}</div>
            <div style={{ fontFamily: "Anton", fontSize: 96, lineHeight: 1, color: C.lime, margin: "6px 0 2px" }}>{q.number}</div>
            <div style={{ color: C.mute, fontSize: 13 }}>Quel joueur portait ce numéro ?</div>
          </>
        ) : (
          <>
            <div style={{ fontFamily: "Anton", fontSize: 34, lineHeight: 1.05, margin: "8px 0 4px", textTransform: "uppercase" }}>{q.player}</div>
            <div style={{ color: C.mute, fontSize: 14 }}>{q.club} · {q.season}</div>
            <div style={{ color: C.mute, fontSize: 13, marginTop: 12 }}>Quel numéro portait-il ?</div>
          </>
        )}
      </div>
      {phase === "ask" ? (
        <div style={{ marginTop: 16 }}>
          <input ref={inputRef} value={val} onChange={(e) => setVal(e.target.value)} onKeyDown={(e) => e.key === "Enter" && submit()}
            inputMode={mode === "reverse" ? "numeric" : "text"} placeholder={mode === "reverse" ? "Numéro…" : "Nom du joueur…"}
            style={{ width: "100%", background: "#0c1119", border: `1px solid ${C.line}`, color: C.ink, borderRadius: 14, padding: 16, fontSize: 17, outline: "none", fontFamily: "Sora" }} />
          <button onClick={submit} disabled={val === ""} style={{ ...btnPrimary, background: val === "" ? "#1c2531" : C.lime, color: val === "" ? C.mute : "#0a0e14" }}>Valider</button>
        </div>
      ) : (
        <div style={{ marginTop: 16, animation: "pop .2s ease both" }}>
          <div style={{ background: last.correct ? `${C.green}14` : `${C.red}14`, border: `1px solid ${last.correct ? C.green : C.red}55`, borderRadius: 16, padding: 16 }}>
            <div style={{ fontWeight: 800, color: last.correct ? C.green : C.red, fontSize: 16 }}>
              {last.exact ? "🎯 Parfait !" : last.correct ? "✅ Bonne réponse" : "❌ Raté"}
              {last.pts > 0 && <span style={{ float: "right", fontFamily: "Anton" }}>+{last.pts}</span>}
            </div>
            <div style={{ marginTop: 8, fontSize: 15 }}>{mode === "quiz" ? <><strong>{q.player}</strong> — {q.number}</> : <><strong>N° {q.number}</strong> · {q.player}</>}</div>
            {mode === "quiz" && <div style={{ color: C.mute, fontSize: 12, marginTop: 4 }}>en {last.sec}s</div>}
          </div>
          <button onClick={next} style={btnPrimary}>{idx >= 9 ? "Terminer 🏆" : "Suivant ›"}</button>
        </div>
      )}
    </div>
  );
}

function Duel({ go }) {
  const deck = useRef(shuffle(DB.filter((d) => d.rarity !== "common").concat(DB)).slice(0, 40));
  const [i, setI] = useState(0); const [turn, setTurn] = useState(0);
  const [sa, setSa] = useState(0); const [sb, setSb] = useState(0);
  const [val, setVal] = useState(""); const [step, setStep] = useState("answer"); const [msg, setMsg] = useState("");
  const startRef = useRef(Date.now());
  const q = deck.current[i % deck.current.length]; const r = RARITY[q.rarity];
  const names = ["Joueur A", "Joueur B"]; const colors = ["#5ad1ff", "#ff7eb6"];
  const winner = sa >= 100 ? 0 : sb >= 100 ? 1 : null;
  useEffect(() => { startRef.current = Date.now(); }, [i, step]);
  const award = (w, p) => (w === 0 ? setSa((s) => s + p) : setSb((s) => s + p));
  const tryAnswer = () => {
    if (val === "") return;
    const sec = (Date.now() - startRef.current) / 1000; const ok = nameMatches(val, q.player);
    if (step === "answer") {
      if (ok) { const p = timeScore(sec) + r.bonus; award(turn, p); setMsg(`✅ ${names[turn]} +${p}`); setStep("reveal"); }
      else { setMsg(`❌ ${names[turn]} se trompe. ${names[1 - turn]} peut voler !`); setVal(""); setStep("steal"); }
    } else { const st = 1 - turn; if (ok) { award(st, 5); setMsg(`🦹 ${names[st]} vole la réponse +5`); } else setMsg("Personne ne marque."); setStep("reveal"); }
  };
  const next = () => { setVal(""); setMsg(""); setStep("answer"); setTurn((t) => 1 - t); setI((x) => x + 1); };
  if (winner !== null) return (
    <div><Confetti /><TopBar go={go} title="Mode Duel" right="" />
      <div style={{ textAlign: "center", marginTop: 60 }}>{ic("👑", 56)}
        <h2 style={{ fontFamily: "Anton", fontSize: 40, margin: "12px 0 4px", color: colors[winner] }}>{names[winner]} gagne !</h2>
        <p style={{ color: C.mute }}>{sa} – {sb}</p>
        <button onClick={() => go("home")} style={btnPrimary}>Retour à l'accueil</button></div>
    </div>
  );
  return (
    <div>
      <TopBar go={go} title="Mode Duel" right="→ 100 pts" />
      <div style={{ display: "flex", gap: 10, margin: "14px 0 18px" }}>
        {names.map((n, k) => (
          <div key={k} style={{ flex: 1, background: turn === k && step === "answer" ? `${colors[k]}1a` : C.panel,
            border: `1px solid ${turn === k && step === "answer" ? colors[k] : C.line}`, borderRadius: 14, padding: 12, textAlign: "center", transition: "all .2s" }}>
            <div style={{ color: colors[k], fontSize: 12, fontWeight: 700 }}>{n}</div>
            <div style={{ fontFamily: "Anton", fontSize: 30 }}>{k === 0 ? sa : sb}</div>
          </div>
        ))}
      </div>
      <div style={{ textAlign: "center", fontSize: 13, marginBottom: 10, animation: step === "steal" ? "pulse 1s infinite" : "none",
        color: step === "steal" ? colors[1 - turn] : C.mute, fontWeight: step === "steal" ? 700 : 400 }}>
        {step === "steal" ? `À ${names[1 - turn]} de voler !` : `Au tour de ${names[turn]}`}
      </div>
      <div style={{ background: C.panel, border: `1px solid ${C.line}`, borderRadius: 20, padding: 20, position: "relative" }}>
        <span style={{ position: "absolute", top: 12, right: 14, fontSize: 11, fontWeight: 700, color: r.color, border: `1px solid ${r.color}55`, borderRadius: 999, padding: "2px 9px" }}>{r.label} +{r.bonus}</span>
        <div style={{ color: C.mute, fontSize: 13 }}>{q.club} · {q.season}</div>
        <div style={{ fontFamily: "Anton", fontSize: 80, lineHeight: 1, color: C.lime, margin: "4px 0" }}>{q.number}</div>
        <div style={{ color: C.mute, fontSize: 13 }}>Qui portait ce numéro ?</div>
      </div>
      {step !== "reveal" ? (
        <div style={{ marginTop: 14 }}>
          {msg && <div style={{ color: C.mute, fontSize: 13, marginBottom: 8 }}>{msg}</div>}
          <input value={val} onChange={(e) => setVal(e.target.value)} onKeyDown={(e) => e.key === "Enter" && tryAnswer()} placeholder="Nom du joueur…"
            style={{ width: "100%", background: "#0c1119", border: `1px solid ${C.line}`, color: C.ink, borderRadius: 14, padding: 16, fontSize: 17, outline: "none", fontFamily: "Sora" }} />
          <button onClick={tryAnswer} style={btnPrimary}>{step === "steal" ? "Voler la réponse" : "Valider"}</button>
        </div>
      ) : (
        <div style={{ marginTop: 14, animation: "pop .2s ease both" }}>
          <div style={{ background: "#0c1119", border: `1px solid ${C.line}`, borderRadius: 16, padding: 16 }}>
            <div style={{ fontWeight: 700 }}>{msg}</div>
            <div style={{ marginTop: 6, color: C.mute, fontSize: 14 }}>Réponse : <strong style={{ color: C.ink }}>{q.player}</strong></div>
          </div>
          <button onClick={next} style={btnPrimary}>Question suivante</button>
        </div>
      )}
    </div>
  );
}

function Leaderboard({ go, profile }) {
  const [list, setList] = useState([]);
  const [live, setLive] = useState(getDB().ready);
  useEffect(() => {
    const sub = () => { setLive(getDB().ready); return getDB().subscribeLeaderboard(setList); };
    let unsub = sub();
    const onReady = () => { if (unsub) unsub(); unsub = sub(); };
    window.addEventListener("kingdb-ready", onReady);
    return () => { if (unsub) unsub(); window.removeEventListener("kingdb-ready", onReady); };
  }, []);
  const medals = ["#ffd166", "#c0c8d4", "#cd7f4d"];
  return (
    <div>
      <TopBar go={go} title="Classement" right={live ? "● en direct" : "local"} />
      <div style={{ textAlign: "center", margin: "18px 0" }}>{ic("👑", 40)}
        <div style={{ color: C.mute, fontSize: 13, marginTop: 4 }}>Le vrai roi des numéros</div></div>
      {list.length === 0 ? (
        <p style={{ color: C.mute, textAlign: "center", marginTop: 30 }}>Aucune partie enregistrée. Joue une manche !</p>
      ) : (
        <div style={{ display: "grid", gap: 8 }}>
          {list.map((p, i) => {
            const me = p.id === profile.id;
            return (
              <div key={p.id} style={{ display: "flex", alignItems: "center", gap: 12, background: me ? `${C.lime}12` : C.panel,
                border: `1px solid ${me ? C.lime + "55" : C.line}`, borderRadius: 14, padding: "12px 14px" }}>
                <div style={{ fontFamily: "Anton", fontSize: 20, width: 28, textAlign: "center", color: medals[i] || C.mute }}>{i + 1}</div>
                <div style={{ flex: 1 }}>
                  <div style={{ fontWeight: 700 }}>{p.pseudo}{me && " (toi)"}</div>
                  <div style={{ color: C.mute, fontSize: 12 }}>{titleFor(p.elo)} · {p.games || 0} parties</div>
                </div>
                <div style={{ fontFamily: "Anton", fontSize: 22, color: C.lime }}>{p.elo}</div>
              </div>
            );
          })}
        </div>
      )}
      {!live && <p style={{ color: C.mute, fontSize: 12, textAlign: "center", marginTop: 20, lineHeight: 1.6 }}>
        Classement local. Renseigne ta config Firebase en haut du fichier pour le partage entre joueurs.</p>}
      <button onClick={() => go("home")} style={btnPrimary}>Rejouer</button>
    </div>
  );
}

function TopBar({ go, title, right }) {
  return (
    <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
      <button onClick={() => go("home")} style={{ background: C.panel, border: `1px solid ${C.line}`, color: C.ink, borderRadius: 10, width: 38, height: 38, display: "grid", placeItems: "center", cursor: "pointer" }}>{ic("🏠", 18)}</button>
      <div style={{ fontWeight: 800, fontSize: 15, flex: 1 }}>{title}</div>
      <span style={{ color: C.mute, fontSize: 13 }}>{right}</span>
    </div>
  );
}
const btnPrimary = { width: "100%", background: C.lime, color: "#0a0e14", border: "none", borderRadius: 14, padding: 16, fontWeight: 800, fontSize: 16, cursor: "pointer", fontFamily: "Sora", marginTop: 16 };

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>
</body>
</html>
